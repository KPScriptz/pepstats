{
  "name": "pepstats",
  "version": "0.7.2",
  "description": "PepStats — League of Legends companion, overlay, and AI coach",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --publish never",
    "check": "node -e \"const{execSync}=require('child_process');const fs=require('fs');const walk=d=>fs.readdirSync(d,{withFileTypes:true}).flatMap(e=>e.isDirectory()?walk(d+'/'+e.name):(e.name.endsWith('.js')?[d+'/'+e.name]:[]));for(const f of [...walk('src'),...walk('scripts')]){execSync('node --check '+JSON.stringify(f));}console.log('All source files OK');\"",
    "release": "node scripts/release.js"
  },
  "author": "KPScriptz",
  "license": "MIT",
  "dependencies": {
    "electron-updater": "^6.8.9",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.kylepeper.pepstats",
    "productName": "PepStats",
    "publish": [
      {
        "provider": "generic",
        "url": "https://github.com/KPScriptz/pepstats/releases/download/latest"
      }
    ],
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "build/icon.ico",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "backend/dist",
        "to": "backend",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "PepStats-Setup-${version}.exe",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico"
    }
  }
}
